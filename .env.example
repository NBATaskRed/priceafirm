# --- Supabase (project: priceafirm) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=http://localhost:3000
# Comma-separated. These accounts get admin screens and bypass the invite gate.
ADMIN_EMAILS=nbachatgpt@gmail.com
# Random 32+ byte secret. Signs opaque discovery slot tokens and cron calls.
SESSION_SECRET=
CRON_SECRET=

# --- Optional ---
# If set, natural-language search intent is parsed by Claude; otherwise the deterministic parser runs alone.
ANTHROPIC_API_KEY=
# Pilot gate: "1" = only invited emails (invites table) or ADMIN_EMAILS can use the app.
INVITE_ONLY=1
# Scoring safety gate: "shadow" computes scores but does not post point deltas; "live" posts them.
SCORING_MODE=live

# --- Valuation requests (invite API) and email ---
# Bearer secret the buyer-qualification system uses for POST /api/invites. 32+ random characters.
INVITE_API_SECRET=
# Lifetime of emailed auto-login links, in days (1-90).
INVITE_TTL_DAYS=30
# Resend (https://resend.com) for valuation request emails. Without these, emails are captured in the outbox only.
RESEND_API_KEY=
MAIL_FROM=PriceAFirm <valuations@priceafirm.com>
MAIL_REPLY_TO=
# "1" = never send, only record in the outbox (staging).
MAIL_CAPTURE=
